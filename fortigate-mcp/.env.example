# Standalone reference only. The Compose cluster reads the root .env.

# FortiOS host (include https:// prefix)
FORTIOS_HOST=https://192.168.1.99

# API token (generate in FortiOS: System > Administrators > REST API Admin)
FORTIOS_API_TOKEN=your-api-token-here

# VDOM to target (default: root)
FORTIOS_VDOM=root

# Use true when the FortiGate certificate is trusted by the container.
FORTIOS_VERIFY_SSL=false

# HTTP timeout in seconds
FORTIOS_TIMEOUT=30

# Set by compose.yaml for the cluster; listed here for standalone runs.
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
