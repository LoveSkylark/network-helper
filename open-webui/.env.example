# Standalone reference only. The Compose cluster reads the root .env.
# Generate a secret key with: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me-to-a-long-random-string

# Local admin created on first boot (only when no users exist).
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_NAME=Admin
WEBUI_ADMIN_PASSWORD=change-me-to-a-strong-password

# Microsoft Entra ID (Azure AD) sign-in.
# Register the app with redirect URI: <WEBUI_URL>/oauth/microsoft/callback
# Use 9188040d-6c67-4c5b-b112-36a304b66dad as the tenant ID for personal Microsoft accounts.
MICROSOFT_CLIENT_ID=your-app-client-id
MICROSOFT_CLIENT_SECRET=your-app-client-secret
MICROSOFT_CLIENT_TENANT_ID=your-tenant-id
