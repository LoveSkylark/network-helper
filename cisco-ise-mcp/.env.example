# Standalone reference only. The Compose cluster reads the root .env.

# ISE server (hostname or IP only, no scheme)
ISE_IP=ise.example.com

# Basic auth for the ISE ERS API (one option; client cert is the other)
API_USERNAME=
API_PWD=

# Client-certificate auth. Paths must be CONTAINER paths; mount ./certs to /certs.
# ISE_CLIENT_CERT=/certs/client.pem
# ISE_CLIENT_KEY=/certs/client.key
# ISE_CLIENT_KEY_PASSWORD=
# ISE_CA_BUNDLE=/certs/ca.pem

# TLS verification (set false only for lab testing)
ISE_VERIFY_SERVER_CERT=true
ISE_VERIFY_HOSTNAME=true

DEBUG_MCP=false
