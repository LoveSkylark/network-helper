# Copy to .env, replace every placeholder, and keep .env private.

# LibreChat
LIBRECHAT_HOSTNAME=chat.example.com
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_DOCKER_SOCKET=/var/run/docker.sock
ACME_DNS_API_BASE=https://auth.example.com
ACME_DNS_ACCOUNT_FILE=/data/certs/acme-dns-account.chat.example.com.json
CREDS_KEY=replace-with-32-byte-hex-secret
CREDS_IV=replace-with-16-byte-hex-secret
JWT_SECRET=replace-with-random-secret
JWT_REFRESH_SECRET=replace-with-another-random-secret
OPENID_SESSION_SECRET=replace-with-random-secret
MONGO_ROOT_PASSWORD=replace-with-random-hex-password
MEILI_MASTER_KEY=replace-with-random-hex-key

# Microsoft Entra ID (OIDC), required when social login is enabled
MICROSOFT_CLIENT_ID=replace-with-client-id
MICROSOFT_CLIENT_SECRET=replace-with-client-secret
MICROSOFT_CLIENT_TENANT_ID=replace-with-tenant-id

# Copilot authentication: github_app (default) or token (individual testing)
COPILOT_AUTH_MODE=github_app
COPILOT_GITHUB_TOKEN=
# GitHub App for organization-billed Copilot Requests
# The app needs the organization Copilot Requests permission (read-only), must
# be installed in the billing organization, and that organization must enable
# GitHub App installation authentication for Copilot.
COPILOT_APP_ID=replace-with-github-app-id
COPILOT_INSTALLATION_ID=replace-with-github-app-installation-id
# Base64-encode the complete PEM private-key file without line breaks.
COPILOT_APP_PRIVATE_KEY_B64=replace-with-base64-encoded-pem
COPILOT_ADAPTER_API_KEY=replace-with-random-hex-secret
# Enable only when sending MCP tool data to GitHub Copilot is approved.
ALLOW_COPILOT_MCP=false

# LiteLLM
LITELLM_MASTER_KEY=sk-replace-with-litellm-master-key
# Separate from the master key. This key is restricted to the models below.
LITELLM_VIRTUAL_KEY=sk-replace-with-librechat-virtual-key
STABLEMASK_HMAC_KEY=replace-with-random-hex-secret
STABLEMASK_REDIS_PASSWORD=replace-with-random-hex-secret
LITELLM_DB_PASSWORD=replace-with-random-hex-password

# Existing Ollama service; it is not started by this Compose project.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3-coder:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# LibreChat RAG vector database
POSTGRES_PASSWORD=replace-with-random-hex-password

# FortiOS
FORTIOS_HOST=https://fortigate.example.com
FORTIOS_API_TOKEN=replace-with-api-token
FORTIOS_VDOM=root
FORTIOS_VERIFY_SSL=true
FORTIOS_TIMEOUT=30

# OpenSearch
OPENSEARCH_URL=https://opensearch.example.com:9200
OPENSEARCH_USERNAME=replace-with-username
OPENSEARCH_PASSWORD=replace-with-password
OPENSEARCH_SSL_VERIFY=true

# Cisco ISE is currently disabled in compose; these are retained for later use.
ISE_IP=ise.example.com
API_USERNAME=replace-with-username
API_PWD=replace-with-password
ISE_VERIFY_SERVER_CERT=true
ISE_VERIFY_HOSTNAME=true
DEBUG_MCP=false

# Cisco ACI
APIC_URL=https://apic.example.com
ACI_USERNAME=replace-with-username
ACI_PASSWORD=replace-with-password

# NetBox
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=replace-with-api-token
NETBOX_VERIFY_SSL=true

# LibreNMS
LIBRENMS_URL=https://librenms.example.com
LIBRENMS_TOKEN=replace-with-api-token
LIBRENMS_VERIFY_SSL=true
